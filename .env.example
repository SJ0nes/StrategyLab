# Trading 212 — DEMO ONLY.
# Generate in the T212 app: Settings → API.
# Do NOT create a live key. Not now, not for this project.
# Restrict the key by IP if you later deploy to a server.
T212_ENVIRONMENT=demo
T212_API_KEY=
T212_API_SECRET=
# Optional: the venue's own spelling of the execution instrument (protocol.yaml
# names it VUAG.L). Unset, the protocol's symbol is sent as written.
T212_TICKER=
