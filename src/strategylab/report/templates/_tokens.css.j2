{#
  The one place the font stack, the spacing scale and the colours are defined.
  Every report includes this, so they read as one instrument. Included inside a
  <style> element; it holds declarations only.
#}
  :root {
    --font: ui-monospace, "SF Mono", "Cascadia Mono", Menlo, Consolas, monospace;
    --font-text: ui-sans-serif, system-ui, "Segoe UI", Helvetica, Arial, sans-serif;
    --s1: 4px;  --s2: 8px;  --s3: 16px;  --s4: 24px;  --s5: 40px;
    --ink: #16181d;
    --ink-soft: #5c6270;
    --rule: #d9dce3;
    --page: #ffffff;
    --panel: #f6f7f9;
    --accent: {{ accent }};
    --warn-bg: #fff6ea;
    --warn-rule: #e0a558;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --ink: #e7e9ee; --ink-soft: #99a0ae; --rule: #2c313b;
      --page: #14161a; --panel: #1b1e24;
      --warn-bg: #2a2113; --warn-rule: #8a6427;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: var(--s5) var(--s4);
    background: var(--page); color: var(--ink);
    font-family: var(--font-text); line-height: 1.5;
    font-variant-numeric: tabular-nums;
  }
  main { max-width: 1180px; margin: 0 auto; }
  h1 { font-size: 1.35rem; margin: 0 0 var(--s1); font-weight: 600; }
  h2 { font-size: 0.95rem; margin: var(--s5) 0 var(--s2); font-weight: 600; }
  .sub { color: var(--ink-soft); font-size: 0.85rem; margin: 0 0 var(--s4); }
  .mono { font-family: var(--font); font-variant-numeric: tabular-nums; }

  .facts { display: flex; flex-wrap: wrap; gap: var(--s1) var(--s4);
           font-family: var(--font); font-size: 0.78rem; color: var(--ink-soft);
           border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule);
           padding: var(--s2) 0; margin-bottom: var(--s4); }
  .facts b { font-weight: 600; color: var(--ink); }

  .banner { background: var(--warn-bg); border-left: 3px solid var(--warn-rule);
            padding: var(--s3); margin: var(--s4) 0; font-size: 0.85rem; }
  .banner b { display: block; margin-bottom: var(--s1); }

  .tick { font-family: var(--font); font-size: 10px; fill: var(--ink-soft); }
  .axis { font-family: var(--font); font-size: 11px; fill: var(--ink); font-weight: 600; }

  footer { margin-top: var(--s5); padding-top: var(--s3); border-top: 1px solid var(--rule);
           color: var(--ink-soft); font-size: 0.75rem; font-family: var(--font);
           word-break: break-all; }
