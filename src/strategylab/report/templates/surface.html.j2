{#
  The search surface.

  One file, no external requests, no build step. The SVG is written inline and
  the interaction is a few lines of plain JavaScript at the bottom. Every token
  of styling is a custom property declared once, so every report this project
  produces reads as the same instrument rather than a folder of one-off figures.
#}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ strategy }} — search surface</title>
<style>
{% include "_tokens.css.j2" %}



  .panels { display: flex; flex-wrap: wrap; gap: var(--s4); align-items: flex-start; }
  .panel { background: var(--panel); border: 1px solid var(--rule); border-radius: 6px;
           padding: var(--s2); margin: 0; }
  svg { display: block; overflow: visible; }
  .cellrect { stroke: var(--page); stroke-width: 1; cursor: crosshair; }
  .cellrect:hover { stroke: var(--ink); stroke-width: 2; }
  .winner { stroke: var(--accent); stroke-width: 3; fill: none; pointer-events: none; }
  .rejected { stroke: var(--ink); stroke-width: 1.25; opacity: 0.55; pointer-events: none; }
  .band { fill: var(--accent); opacity: 0.22; }
  .bandedge { stroke: var(--accent); stroke-width: 1.5; }
  .axisline { stroke: var(--rule); stroke-width: 1; }
  .celltick { stroke: var(--ink); stroke-width: 1; opacity: 0.45; }
  .trialtick { stroke: var(--accent); stroke-width: 1; opacity: 0.7; }
  .benchmark { stroke: var(--ink-soft); stroke-width: 1.5; stroke-dasharray: 4 3; }
  .candidate { stroke: var(--ink); stroke-width: 2.5; fill: var(--ink); }
  .curve { background: var(--panel); border: 1px solid var(--rule); border-radius: 6px;
           padding: var(--s3); min-height: 280px; font-family: var(--font); font-size: 0.8rem; }
  .curve .none { color: var(--ink-soft); }
  .curve .own { stroke: var(--ink); stroke-width: 1.6; fill: none; }
  .curve .held { stroke: var(--ink-soft); stroke-width: 1.2; fill: none; stroke-dasharray: 4 3; }
  .curve .base { stroke: var(--rule); stroke-width: 1; }
  .cellrect.chosen { stroke: var(--ink); stroke-width: 3; }

  .readout { position: sticky; bottom: 0; margin-top: var(--s4);
             background: var(--page); border-top: 2px solid var(--rule);
             padding: var(--s3) 0 var(--s2); font-family: var(--font); font-size: 0.82rem;
             min-height: 5.4rem; }
  .readout .none { color: var(--ink-soft); }
  .readout dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
                gap: var(--s1) var(--s3); margin: var(--s2) 0 0; }
  .readout dt { color: var(--ink-soft); font-size: 0.72rem; }
  .readout dd { margin: 0; }
  .flag { display: inline-block; padding: 1px 6px; border-radius: 3px; font-size: 0.72rem;
          border: 1px solid currentColor; margin-left: var(--s2); }

  table { border-collapse: collapse; font-family: var(--font); font-size: 0.8rem; }
  th, td { text-align: left; padding: var(--s1) var(--s3) var(--s1) 0; }
  th { color: var(--ink-soft); font-weight: 600; }
  td.num { text-align: right; padding-right: var(--s4); }
</style>
</head>
<body>
<main>

<h1>{{ strategy }} — search surface</h1>
<p class="sub">
  {{ grid_size }} cells, {{ across }} across{% if down %} × {{ down }} down{% endif %}
  {%- if panels|length > 1 %}, one panel per facet{% endif %}.
  Coloured by each cell's own {{ metric }}.
</p>

<div class="facts">
  <span><b>protocol</b> v{{ protocol_version }}</span>
  <span><b>window</b> {{ window.start }} → {{ window.end }} ({{ window.bars }} bars)</span>
  <span><b>instrument</b> {{ instrument }}</span>
  <span><b>snapshot</b> {{ fixture_hash[:16] }}</span>
  <span><b>radius</b> {{ plateau_radius }}</span>
  <span><b>drawdown ceiling</b> {{ max_drawdown_ceiling_pct }}%</span>
</div>

<div class="banner verdict-{{ noise_gate.status }}">
  <b>
    {% if noise_gate.status == "passed" %}
      Noise gate PASSED.
    {% elif noise_gate.status == "failed" %}
      Noise gate FAILED. This candidate cannot be validated.
    {% elif noise_gate.status == "undetermined" %}
      NO VERDICT from the noise gate: too few surrogates to judge on.
    {% elif noise_gate.status == "not_computed" %}
      No noise ceiling was computed, so nothing on this page is yet evidence of an edge.
    {% else %}
      No candidate survived selection, so the noise gate judged nothing.
    {% endif %}
  </b>
  {{ noise_gate.summary }}
  {% if noise_ceiling is none %}
  {{ noise_ceiling_note }}
  The axis below would carry the surrogates' distribution as a shaded band. It is absent
  because nothing was computed, not because it was left out.
  {% else %}
  <br><br>
  Best-in-grid Sharpe across {{ noise_ceiling.trials }} surrogate series
  ({{ noise_ceiling.scoreable_trials }} scoreable):
  {% if noise_ceiling.percentiles.p50 is not none %}
  median {{ '%.3f'|format(noise_ceiling.percentiles.p50) }},
  90th {{ '%.3f'|format(noise_ceiling.percentiles.p90) }},
  95th {{ '%.3f'|format(noise_ceiling.percentiles.p95) }},
  max {{ '%.3f'|format(noise_ceiling.max) }}.
  {% else %}
  none of them produced a figure.
  {% endif %}
  {{ noise_ceiling_note }}
  <br><br>
  <b>These surrogates are not noise.</b> Blocks are as long as the grid's longest lookback,
  so each one is a verbatim stretch of real history at a rescaled price level. What this
  compares against is a REORDERING OF THIS MARKET'S OWN REGIMES, which is a harder and
  narrower test than noise — and not the one the project rules describe. See
  docs/decisions/0008. The rule the verdict follows is in docs/decisions/0012.
  {% endif %}
</div>

<h2>The surface</h2>
<div class="panels">
{% for panel in panels %}
  {% set pindex = loop.index0 %}
  <figure class="panel">
    <svg width="{{ panel_width }}" height="{{ panel_height }}"
         viewBox="0 0 {{ panel_width }} {{ panel_height }}" role="img"
         aria-label="Heatmap of {{ metric }} for {{ panel.title }}">
      <text class="axis" x="{{ pad }}" y="18">{{ panel.title }}</text>
      <text class="axis" x="{{ pad }}" y="{{ pad - 26 }}">{{ across }} →</text>
      {% for tick in panel.across_ticks %}
      <text class="tick" x="{{ tick.x }}" y="{{ pad - 8 }}" text-anchor="middle">{{ tick.label }}</text>
      {% endfor %}
      {% for tick in panel.down_ticks %}
      <text class="tick" x="{{ pad - 8 }}" y="{{ tick.y + 4 }}" text-anchor="end">{{ tick.label }}</text>
      {% endfor %}
      {% if down %}
      <text class="axis" x="4" y="{{ pad - 26 }}">{{ down }} ↓</text>
      {% endif %}
      {% for c in panel.cells %}
      <rect class="cellrect" x="{{ c.x }}" y="{{ c.y }}" width="{{ cell }}" height="{{ cell }}"
            fill="{{ c.fill }}" data-cell="{{ loop.index0 }}" data-panel="{{ pindex }}"
            tabindex="0" role="button"><title>{{ c.label }}</title></rect>
      {% if c.failed %}
      {# A failed cell is hatched as well as darkened, so it survives greyscale
         and colour blindness. It must never read as "nothing here". #}
      <path d="M{{ c.x }} {{ c.y + cell }} L{{ c.x + cell }} {{ c.y }}
               M{{ c.x }} {{ c.y + cell / 2 }} L{{ c.x + cell / 2 }} {{ c.y }}
               M{{ c.x + cell / 2 }} {{ c.y + cell }} L{{ c.x + cell }} {{ c.y + cell / 2 }}"
            stroke="#9aa0ad" stroke-width="1.5" fill="none" pointer-events="none"/>
      {% endif %}
      {% if c.rejected %}
      <circle class="rejected" cx="{{ c.x + cell - 9 }}" cy="{{ c.y + 9 }}" r="4" fill="none"/>
      {% endif %}
      {% if c.winner %}
      <rect class="winner" x="{{ c.x + 2 }}" y="{{ c.y + 2 }}"
            width="{{ cell - 4 }}" height="{{ cell - 4 }}"/>
      {% endif %}
      {% endfor %}
    </svg>
  </figure>
{% endfor %}
</div>

<svg width="320" height="46" style="margin-top:var(--s4)" role="img"
     aria-label="Colour scale from {{ '%.3f'|format(legend.low) }} to {{ '%.3f'|format(legend.high) }}">
  <defs>
    <linearGradient id="ramp" x1="0" x2="1" y1="0" y2="0">
      {% for stop in legend.stops %}
      <stop offset="{{ stop.offset }}%" stop-color="{{ stop.colour }}"/>
      {% endfor %}
    </linearGradient>
  </defs>
  <rect x="0" y="4" width="300" height="12" fill="url(#ramp)"/>
  <text class="tick" x="0" y="32">{{ '%.3f'|format(legend.low) }}</text>
  <text class="tick" x="300" y="32" text-anchor="end">{{ '%.3f'|format(legend.high) }}</text>
  <text class="tick" x="150" y="32" text-anchor="middle">{{ metric }}</text>
</svg>

<h2>Every {{ metric }} on one axis</h2>
<p class="sub">
  Each tick on the upper row is one cell of this grid. Each tick on the lower row is the BEST
  cell the same grid found on one surrogate series, and the shaded band runs from the median
  of those to their 95th percentile. A candidate inside or left of the band is what a search
  of this size finds without an edge.
</p>
{% set ax = sharpe_axis %}
<svg width="{{ ax.width }}" height="118" viewBox="0 0 {{ ax.width }} 118" role="img"
     aria-label="All {{ metric }} values on one axis, from {{ '%.3f'|format(ax.low) }} to {{ '%.3f'|format(ax.high) }}">
  {% if ax.band %}
  <rect class="band" x="{{ ax.band.p50 }}" y="10" width="{{ ax.band.p95 - ax.band.p50 }}" height="74"/>
  <line class="bandedge" x1="{{ ax.band.p95 }}" x2="{{ ax.band.p95 }}" y1="6" y2="88"/>
  <text class="tick" x="{{ ax.band.p95 }}" y="100" text-anchor="middle">95th {{ '%.3f'|format(ax.band.p95_value) }}</text>
  {% endif %}
  <line class="axisline" x1="{{ ax.pad }}" x2="{{ ax.width - ax.pad }}" y1="47" y2="47"/>
  <line class="axisline" x1="{{ ax.zero }}" x2="{{ ax.zero }}" y1="10" y2="84"/>
  {% for x in ax.cells %}
  <line class="celltick" x1="{{ x }}" x2="{{ x }}" y1="16" y2="42"/>
  {% endfor %}
  {% for x in ax.trials %}
  <line class="trialtick" x1="{{ x }}" x2="{{ x }}" y1="52" y2="78"/>
  {% endfor %}
  {% if ax.benchmark %}
  <line class="benchmark" x1="{{ ax.benchmark.x }}" x2="{{ ax.benchmark.x }}" y1="6" y2="88"/>
  <text class="tick" x="{{ ax.benchmark.x }}" y="114" text-anchor="middle">buy and hold {{ '%.3f'|format(ax.benchmark.value) }}</text>
  {% endif %}
  {% if ax.winner %}
  <path class="candidate" d="M{{ ax.winner.x }} 10 l6 -8 h-12 z"/>
  <line class="candidate" x1="{{ ax.winner.x }}" x2="{{ ax.winner.x }}" y1="10" y2="84"/>
  {% endif %}
  <text class="tick" x="{{ ax.pad }}" y="100">{{ '%.3f'|format(ax.low) }}</text>
  <text class="tick" x="{{ ax.width - ax.pad }}" y="100" text-anchor="end">{{ '%.3f'|format(ax.high) }}</text>
  {# Labelled only where it will not sit on top of an end label. #}
  {% if ax.zero > ax.pad + 44 and ax.zero < ax.width - ax.pad - 44 %}
  <text class="tick" x="{{ ax.zero }}" y="100" text-anchor="middle">0</text>
  {% endif %}
  <text class="tick" x="{{ ax.pad }}" y="12">cells</text>
  <text class="tick" x="{{ ax.pad }}" y="90">surrogates</text>
</svg>
<p class="sub">
  {% if ax.winner %}The candidate is the heavy marker, at {{ '%.3f'|format(ax.winner.value) }}.{% endif %}
  {% if not ax.band %}No surrogate distribution is drawn because none was computed.{% endif %}
</p>

<h2>Equity curve</h2>
<div id="curve" class="curve" aria-live="polite">
  <span class="none">Click a cell, or focus one and press Enter, to draw its curve against
  holding {{ instrument }} over the same bars.</span>
</div>

<div class="readout" id="readout" aria-live="polite">
  <span class="none">Hover or focus a cell.</span>
</div>

<h2>Outcome</h2>
{% if winner %}
<p class="mono">
  Candidate {{ winner.params|dictsort|map('join', '=')|join(', ') }} —
  plateau {{ '%.3f'|format(winner.plateau_score) }} over {{ winner.neighbour_count }} cells,
  own {{ metric }} {{ '%.3f'|format(winner[metric]) }},
  drawdown {{ '%.2f'|format(winner.max_drawdown_pct) }}%
  {%- if winner.degenerate %}<span class="flag">degenerate plateau</span>{% endif %}
</p>
{% else %}
<p class="mono">No candidate survived. Every scoreable cell was rejected.</p>
{% endif %}
{% if benchmark %}
<p class="mono">
  Holding {{ benchmark.instrument }} from {{ benchmark.start }} to {{ benchmark.end }}
  ({{ benchmark.bars }} bars, {% if benchmark.basis == "winner" %}the candidate's own{% else %}the whole window{% endif %}):
  {{ metric }} {{ '%.3f'|format(benchmark[metric]) }},
  drawdown {{ '%.2f'|format(benchmark.max_drawdown_pct) }}%.
  No costs, always fully invested. Reported, not applied: nothing was rejected for losing to it.
</p>
{% endif %}

<table>
  <tr><th>outcome</th><th>cells</th></tr>
  {% for entry in outcomes %}
  <tr><td>{{ entry.label }}</td><td class="num">{{ entry.count }}</td></tr>
  {% endfor %}
  <tr><td><b>grid</b></td><td class="num"><b>{{ grid_size }}</b></td></tr>
</table>
<p class="sub" style="margin-top:var(--s2)">
  Every cell appears in exactly one row. "Not examined" is not a pass: selection
  walks the cells best-first and stops at the first survivor, so anything ranked
  below the candidate was never looked at.
</p>

<footer>
  <div>{{ command }}</div>
  <div>config {{ config }} · generated {{ generated_at }}</div>
  <div>snapshot {{ fixture_hash }}</div>
  <div>costs, fractions — spread {{ costs_frac.spread }} · slippage {{ costs_frac.slippage }}
       · commission {{ costs_frac.commission }} · fx {{ costs_frac.fx_conversion }}</div>
</footer>

</main>
<script id="surface-data" type="application/json">{{ panels|tojson }}</script>
<script id="curve-data" type="application/json">{{ curves|tojson }}</script>
<script>
(function () {
  "use strict";
  var panels = JSON.parse(document.getElementById("surface-data").textContent);
  var readout = document.getElementById("readout");
  var metric = {{ metric|tojson }};

  function num(value, digits) {
    return value === null || value === undefined ? "—" : value.toFixed(digits);
  }

  function show(cell) {
    var rows = [
      ["cell", cell.label],
      [metric, cell.failed ? "did not run" : num(cell.value, 4)],
      ["plateau score", num(cell.plateau_score, 4)],
      ["neighbours", cell.neighbour_count],
      ["drawdown %", num(cell.max_drawdown_pct, 2)],
      ["trades", cell.trade_count],
      ["traded", cell.traded ? "yes" : "no trades"],
      // "not examined" rather than "kept": selection stops at the first
      // survivor, so a cell ranked below the candidate faced no checks at all.
      ["outcome", cell.failed ? "failed" : (cell.rejected || (cell.winner ? "candidate" : "not examined"))]
    ];
    var html = "<dl>";
    for (var i = 0; i < rows.length; i++) {
      html += "<dt>" + rows[i][0] + "</dt><dd>" + rows[i][1] + "</dd>";
    }
    readout.innerHTML = html + "</dl>";
  }

  function bind(event) {
    var target = event.target;
    if (!target || !target.dataset || target.dataset.cell === undefined) { return; }
    show(panels[+target.dataset.panel].cells[+target.dataset.cell]);
  }

  document.addEventListener("mouseover", bind);
  document.addEventListener("focusin", bind);

  // --- the equity curve --------------------------------------------------------
  // Drawn from points the search stored THINNED, for drawing. Nothing here
  // computes a Sharpe or a drawdown: those are the search's, shown in the readout.
  var curves = JSON.parse(document.getElementById("curve-data").textContent);
  var curveBox = document.getElementById("curve");
  var W = 760, H = 240, PADX = 8, PADY = 14;

  function path(values, low, high) {
    var out = "", span = high - low || 1, n = values.length;
    for (var i = 0; i < n; i++) {
      var x = PADX + (n === 1 ? 0.5 : i / (n - 1)) * (W - 2 * PADX);
      var y = PADY + (1 - (values[i] - low) / span) * (H - 2 * PADY);
      out += (i ? "L" : "M") + x.toFixed(1) + " " + y.toFixed(1);
    }
    return out;
  }

  function draw(cell) {
    var stored = curves.cells[cell.index];
    if (!stored) {
      curveBox.innerHTML = "<b>" + cell.label + "</b> did not run, so it has no curve.";
      return;
    }
    var first = 0;
    while (first < stored.length && stored[first] === null) { first++; }
    var own = [], held = [];
    for (var i = first; i < stored.length; i++) {
      own.push(stored[i] / stored[first]);
      held.push(curves.close[i] / curves.close[first]);
    }
    var low = Math.min.apply(null, own.concat(held, [1]));
    var high = Math.max.apply(null, own.concat(held, [1]));
    var baseY = PADY + (1 - (1 - low) / (high - low || 1)) * (H - 2 * PADY);
    curveBox.innerHTML =
      "<b>" + cell.label + "</b> &nbsp; " + curves.dates[first] + " to " +
      curves.dates[curves.dates.length - 1] + ", growth of 1" +
      '<svg width="' + W + '" height="' + H + '" viewBox="0 0 ' + W + " " + H + '" role="img"' +
      ' aria-label="Equity curve for ' + cell.label + '">' +
      '<line class="base" x1="' + PADX + '" x2="' + (W - PADX) + '" y1="' + baseY.toFixed(1) +
      '" y2="' + baseY.toFixed(1) + '"/>' +
      '<path class="held" d="' + path(held, low, high) + '"/>' +
      '<path class="own" d="' + path(own, low, high) + '"/></svg>' +
      "solid: this cell, ends at " + own[own.length - 1].toFixed(3) +
      " &nbsp; dashed: holding, ends at " + held[held.length - 1].toFixed(3) +
      " &nbsp; range " + low.toFixed(3) + " to " + high.toFixed(3) +
      "<br>" + own.length + " stored points, thinned for drawing. " +
      "The figures in the readout are from the full curve.";
  }

  function choose(event) {
    var target = event.target;
    if (!target || !target.dataset || target.dataset.cell === undefined) { return; }
    if (event.type === "keydown" && event.key !== "Enter" && event.key !== " ") { return; }
    var marked = document.querySelector(".cellrect.chosen");
    if (marked) { marked.classList.remove("chosen"); }
    target.classList.add("chosen");
    draw(panels[+target.dataset.panel].cells[+target.dataset.cell]);
    if (event.type === "keydown") { event.preventDefault(); }
  }

  document.addEventListener("click", choose);
  document.addEventListener("keydown", choose);
}());
</script>
</body>
</html>
